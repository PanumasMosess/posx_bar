// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS (กำหนดตัวเลือกสถานะต่างๆ เพื่อป้องกันการพิมพ์ผิด)
enum OrderStatus {
  CART
  HOLD
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KitchenStatus {
  IDLE // ยังไม่ส่งเข้าครัว (อยู่ในตะกร้า)
  NOT_REQUIRED // ไม่ต้องส่งครัว (เช่น น้ำอัดลม หยิบเองหน้าบาร์ได้เลย)
  IN_KITCHEN // ไปโชว์ที่หน้าจอครัวแล้ว (รอครัวกดเสิร์ฟ)
  SERVED // ครัวกดปุ่ม "ส่งอาหารแล้ว" (จบ)
  COMPLETED
}

enum PaymentMethod {
  CASH
  QR
  CARD
  MEMBER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model organizations {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String?
  ownerId   Int
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  products   products[]
  qrcodes    qrcodes[]
  orders     orders[]
  payments   payments[]
  categories categories[]
  shifts     shifts[]
  employees              employees[]
  organizationSetting    organizations_settings?
}

model products {
  id       Int     @id @default(autoincrement())
  code     String? @unique
  name     String
  price    Float
  cost     Float
  image    String?
  stock    Int?    @default(0)
  isActive Boolean @default(true)
  detail   String?
  barcode  String?

  // ความสัมพันธ์
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  categoryId Int?
  category   categories? @relation(fields: [categoryId], references: [id])

  orderItems   orderitems[]
  optionGroups optiongroups[]

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model optiongroups {
  id            Int     @id @default(autoincrement())
  name          String // ชื่อกลุ่ม เช่น "ระดับความหวาน"
  isRequired    Boolean @default(false) // บังคับเลือกหรือไม่ (true = บังคับ, false = ไม่บังคับ)
  allowMultiple Boolean @default(false) // เลือกได้หลายอันหรือไม่ (true = เลือกท็อปปิ้งได้หลายอัน, false = เลือกไซส์ได้แค่อันเดียว)
  isActive      Boolean @default(true)

  productId Int
  product   products @relation(fields: [productId], references: [id], onDelete: Cascade) // ถ้าลบสินค้า ให้ลบกลุ่มตัวเลือกตามไปด้วย

  choices optionchoices[] // ตัวเลือกย่อยในกลุ่มนี้

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model optionchoices {
  id       Int     @id @default(autoincrement())
  name     String // ชื่อตัวเลือก เช่น "เพิ่มไข่มุก", "หวาน 50%", "แก้วใหญ่"
  priceAdd Float   @default(0) // ราคาบวกเพิ่ม (ถ้าไม่มีให้เป็น 0)
  isActive Boolean @default(true)

  optionGroupId Int
  optionGroup   optiongroups @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model qrcodes {
  id        Int     @id @default(autoincrement())
  token     String  @unique
  tableName String
  isActive  Boolean @default(true)

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  orders orders[]

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model orders {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique
  status        OrderStatus   @default(CART)
  orderType     OrderType     @default(DINE_IN)
  kitchenStatus KitchenStatus @default(SERVED)

  totalAmount Float @default(0)
  discount    Float @default(0)
  netAmount   Float @default(0)

  qrCodeId Int?
  qrcode   qrcodes? @relation(fields: [qrCodeId], references: [id])

  customerName    String?
  customerPhone   String?
  deliveryAddress String?

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])
  items          orderitems[]
  payments       payments[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    shifts?  @relation(fields: [shiftsId], references: [id])
  shiftsId  Int?
}

model orderitems {
  id          Int           @id @default(autoincrement())
  quantity    Int           @default(1)
  priceAtTime Float
  options     String?
  status      KitchenStatus @default(IDLE)

  orderId   Int
  order     orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   products @relation(fields: [productId], references: [id])

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model categories {
  id       Int     @id @default(autoincrement())
  name     String
  isActive Boolean @default(true)

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  products products[]

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model payments {
  id             Int           @id @default(autoincrement())
  amount         Float // ยอดชำระสุทธิ
  receivedAmount Float? // ยอดเงินที่รับมาจากลูกค้า (กรณีจ่ายเงินสด)
  changeAmount   Float? // จำนวนเงินทอน
  method         PaymentMethod @default(CASH)
  referenceNo    String?
  isCompleted    Boolean       @default(true)

  orderId        Int
  order          orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  shiftId Int?
  shift   shifts? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model shifts {
  id          Int         @id @default(autoincrement())
  shiftNumber String
  status      ShiftStatus @default(OPEN)

  // ยอดเงินสดเริ่มต้นและยอดเงินนับจริงเมื่อปิดกะ
  startingCash   Float  @default(0) // เงินทอนเริ่มต้นกะ
  expectedCash   Float  @default(0) // ยอดเงินสดที่ควรจะมีในลิ้นชัก (คำนวณจาก System)
  endingCash     Float? // ยอดเงินสดที่แคชเชียร์นับได้จริงตอนปิดกะ
  cashDifference Float? // ยอดเงินเกิน/ขาด (endingCash - expectedCash)

  // สรุปยอดขายแยกตามประเภทชำระเงินประจำกะ (Auto Sync ตอนปิดกะ)
  totalSales  Float @default(0) // ยอดขายรวมสุทธิทั้งหมด
  cashSales   Float @default(0) // ยอดขายเงินสด
  qrSales     Float @default(0) // ยอดขายสแกน QR / โอน
  cardSales   Float @default(0) // ยอดขายบัตรเครดิต
  memberSales Float @default(0) // ยอดขายตัดกระเป๋าสมาชิก

  note String?

  openedBy String // ชื่อหรือ ID ของพนักงานที่เปิดกะ
  closedBy String? // ชื่อหรือ ID ของพนักงานที่ปิดกะ

  openedAt DateTime  @default(now())
  closedAt DateTime?

  // ความสัมพันธ์กับ Organization และ Payments / Orders
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  payments payments[] // ประวัติการชำระเงินทั้งหมดในกะนี้
  orders   orders[] // ออเดอร์ทั้งหมดที่เกิดขึ้นในกะนี้

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model organizations_settings {
  id                Int      @id @default(autoincrement())
  currencyCode      String   @default("THB")       // เช่น THB, USD, LAK
  currencyLabel     String   @default("บาท · THB") // ข้อความที่ใช้โชว์ใน UI
  businessHours     String   @default("08:00 - 22:30") // เวลาเปิด-ปิด
  phone             String?  // เบอร์โทรศัพท์ร้าน
  address           String?  // ที่อยู่ร้าน
  receiptFooter     String?  // ข้อความท้ายใบเสร็จ (เช่น "ขอบคุณที่ใช้บริการ WiFi: 1234")
  organizationId    Int   @unique
  organization      organizations @relation(fields: [organizationId], references: [id])

  updatedAt         DateTime @updatedAt
}

model employees {
  id             Int      @id @default(autoincrement())
  name           String   // ชื่อพนักงาน
  role           String   @default("พนักงาน") // ตำแหน่ง/หน้าที่
  pin            String   // PIN 4-6 หลัก สำหรับ Login เข้าเครื่อง POS
  img            String?  // เก็บ URL หรือ Path ของรูปภาพโปรไฟล์
  isActive       Boolean  @default(true) // สถานะ เปิด/ปิด การใช้งาน
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])
  permission     employee_permissions? 
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model employee_permissions {
  id                Int      @id @default(autoincrement())
  accessPos         Boolean  @default(false) // เข้าถึงหน้าขาย (POS)
  accessSettings    Boolean  @default(false) // เข้าถึงหน้าตั้งค่า (Settings)
  accessReports     Boolean  @default(false) // เข้าถึงหน้ารายงาน (Reports)
  accessExpenses    Boolean  @default(false) // เข้าถึงหน้ารายจ่าย (Expenses)
  cancelRefund      Boolean  @default(false) // สิทธิ์ในการกดยกเลิกบิลหรือคืนเงิน (Cancel / Refund)
  employeeId        Int      @unique
  employee          employees @relation(fields: [employeeId], references: [id]) 
}