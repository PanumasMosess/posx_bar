// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS (กำหนดตัวเลือกสถานะต่างๆ เพื่อป้องกันการพิมพ์ผิด)
enum OrderStatus {
  CART
  HOLD
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KitchenStatus {
  IDLE // ยังไม่ส่งเข้าครัว (อยู่ในตะกร้า)
  NOT_REQUIRED // ไม่ต้องส่งครัว (เช่น น้ำอัดลม หยิบเองหน้าบาร์ได้เลย)
  IN_KITCHEN // ไปโชว์ที่หน้าจอครัวแล้ว (รอครัวกดเสิร์ฟ)
  SERVED // ครัวกดปุ่ม "ส่งอาหารแล้ว" (จบ)
  COMPLETED
}

enum PaymentMethod {
  CASH
  QR
  CARD
  MEMBER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model organizations {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String?
  ownerId   Int
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  products            products[]
  qrcodes             qrcodes[]
  orders              orders[]
  payments            payments[]
  categories          categories[]
  shifts              shifts[]
  employees           employees[]
  paymentSettings     payments_settings[]
  organizationSetting organizations_settings?
  stockMovements      StockMovement[]
  members             member[]
  memberTiers         membertier[]
  memberTransactions  membertransaction[]
}

model products {
  id           Int     @id @default(autoincrement())
  code         String? @unique
  name         String
  price        Float
  cost         Float
  image        String?
  stock        Int?    @default(0)
  isActive     Boolean @default(true)
  detail       String?
  barcode      String?
  isTrackStock Boolean @default(false)

  // ความสัมพันธ์
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  categoryId Int?
  category   categories? @relation(fields: [categoryId], references: [id])

  orderItems     orderitems[]
  optionGroups   optiongroups[]
  stockMovements StockMovement[]

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model optiongroups {
  id            Int     @id @default(autoincrement())
  name          String // ชื่อกลุ่ม เช่น "ระดับความหวาน"
  isRequired    Boolean @default(false) // บังคับเลือกหรือไม่ (true = บังคับ, false = ไม่บังคับ)
  allowMultiple Boolean @default(false) // เลือกได้หลายอันหรือไม่ (true = เลือกท็อปปิ้งได้หลายอัน, false = เลือกไซส์ได้แค่อันเดียว)
  isActive      Boolean @default(true)

  productId Int
  product   products @relation(fields: [productId], references: [id], onDelete: Cascade) // ถ้าลบสินค้า ให้ลบกลุ่มตัวเลือกตามไปด้วย

  choices optionchoices[] // ตัวเลือกย่อยในกลุ่มนี้

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model optionchoices {
  id       Int     @id @default(autoincrement())
  name     String // ชื่อตัวเลือก เช่น "เพิ่มไข่มุก", "หวาน 50%", "แก้วใหญ่"
  priceAdd Float   @default(0) // ราคาบวกเพิ่ม (ถ้าไม่มีให้เป็น 0)
  isActive Boolean @default(true)

  optionGroupId Int
  optionGroup   optiongroups @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model qrcodes {
  id        Int     @id @default(autoincrement())
  token     String? @unique
  tableName String
  isActive  Boolean @default(true)

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  orders orders[]

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model orders {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique
  status        OrderStatus   @default(CART)
  orderType     OrderType     @default(DINE_IN)
  kitchenStatus KitchenStatus @default(SERVED)

  totalAmount Float @default(0)
  discount    Float @default(0)
  netAmount   Float @default(0)

  qrCodeId Int?
  qrcode   qrcodes? @relation(fields: [qrCodeId], references: [id])

  customerName    String?
  customerPhone   String?
  deliveryAddress String?

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])
  items          orderitems[]
  payments       payments[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    shifts?  @relation(fields: [shiftsId], references: [id])
  shiftsId  Int?

  memberId       Int?
  member         member?  @relation(fields: [memberId], references: [id])
  memberTransactions membertransaction[]
}

model orderitems {
  id          Int           @id @default(autoincrement())
  quantity    Int           @default(1)
  priceAtTime Float
  options     String?
  status      KitchenStatus @default(IDLE)

  orderId   Int
  order     orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   products @relation(fields: [productId], references: [id])

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model categories {
  id       Int     @id @default(autoincrement())
  name     String
  isActive Boolean @default(true)

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  products products[]

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model payments {
  id             Int           @id @default(autoincrement())
  amount         Float // ยอดชำระสุทธิ
  receivedAmount Float? // ยอดเงินที่รับมาจากลูกค้า (กรณีจ่ายเงินสด)
  changeAmount   Float? // จำนวนเงินทอน
  method         PaymentMethod @default(CASH)
  referenceNo    String?
  isCompleted    Boolean       @default(true)

  orderId        Int
  order          orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  shiftId Int?
  shift   shifts? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model shifts {
  id          Int         @id @default(autoincrement())
  shiftNumber String
  status      ShiftStatus @default(OPEN)

  // ยอดเงินสดเริ่มต้นและยอดเงินนับจริงเมื่อปิดกะ
  startingCash   Float  @default(0) // เงินทอนเริ่มต้นกะ
  expectedCash   Float  @default(0) // ยอดเงินสดที่ควรจะมีในลิ้นชัก (คำนวณจาก System)
  endingCash     Float? // ยอดเงินสดที่แคชเชียร์นับได้จริงตอนปิดกะ
  cashDifference Float? // ยอดเงินเกิน/ขาด (endingCash - expectedCash)

  // สรุปยอดขายแยกตามประเภทชำระเงินประจำกะ (Auto Sync ตอนปิดกะ)
  totalSales  Float @default(0) // ยอดขายรวมสุทธิทั้งหมด
  cashSales   Float @default(0) // ยอดขายเงินสด
  qrSales     Float @default(0) // ยอดขายสแกน QR / โอน
  cardSales   Float @default(0) // ยอดขายบัตรเครดิต
  memberSales Float @default(0) // ยอดขายตัดกระเป๋าสมาชิก

  note String?

  openedBy String // ชื่อหรือ ID ของพนักงานที่เปิดกะ
  closedBy String? // ชื่อหรือ ID ของพนักงานที่ปิดกะ

  openedAt DateTime  @default(now())
  closedAt DateTime?

  // ความสัมพันธ์กับ Organization และ Payments / Orders
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  payments payments[] // ประวัติการชำระเงินทั้งหมดในกะนี้
  orders   orders[] // ออเดอร์ทั้งหมดที่เกิดขึ้นในกะนี้

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model organizations_settings {
  id                Int           @id @default(autoincrement())
  currencyCode      String        @default("THB")
  openTime          String?
  closeTime         String?
  isManualOpenClose Boolean       @default(false) // เก็บค่าสวิตช์โหมดเปิด-ปิดร้าน (true = เปิดโหมด, false = ปิดโหมด)
  phone             String?
  address           String?
  receiptFooter     String?
  taxId             String?
  organizationId    Int           @unique
  organization      organizations @relation(fields: [organizationId], references: [id])

  updatedAt DateTime @updatedAt
}

model employees {
  id             Int                   @id @default(autoincrement())
  name           String // ชื่อพนักงาน
  role           String                @default("พนักงาน") // ตำแหน่ง/หน้าที่
  pin            String                @unique // PIN 4-6 หลัก สำหรับ Login เข้าเครื่อง POS
  img            String? // เก็บ URL หรือ Path ของรูปภาพโปรไฟล์
  isActive       Boolean               @default(true) // สถานะ เปิด/ปิด การใช้งาน
  organizationId Int
  organization   organizations         @relation(fields: [organizationId], references: [id])
  permission     employee_permissions?
  createdBy      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  memberTransactions membertransaction[]
}

model employee_permissions {
  id             Int       @id @default(autoincrement())
  accessPos      Boolean   @default(false) // เข้าถึงหน้าขาย (POS)
  accessSettings Boolean   @default(false) // เข้าถึงหน้าตั้งค่า (Settings)
  accessReports  Boolean   @default(false) // เข้าถึงหน้ารายงาน (Reports)
  accessExpenses Boolean   @default(false) // เข้าถึงหน้ารายจ่าย (Expenses)
  cancelRefund   Boolean   @default(false) // สิทธิ์ในการกดยกเลิกบิลหรือคืนเงิน (Cancel / Refund)
  employeeId     Int       @unique
  employee       employees @relation(fields: [employeeId], references: [id])
}

model payments_settings {
  id              Int           @id @default(autoincrement())
  promptPayName   String? // ชื่อบัญชี หรือ ชื่อกำกับที่จะแสดงใต้ QR
  promptPayNumber String? // เลขพร้อมเพย์ (เบอร์โทร/เลขบัตรปชช.) สำหรับเอาไปสร้าง QR อัตโนมัติ
  qrImageUrl      String? // ลิงก์รูปภาพ QR Code (กรณีที่ร้านอัปโหลดรูปเอง ไม่ได้ให้ระบบ Gen)
  creditCardFee   Float? // ค่าธรรมเนียม (ถ้าเป็น null แปลว่าร้านนี้ไม่รับบัตรเครดิต ไม่ต้องแสดงปุ่ม)
  organizationId  Int           @unique
  organization    organizations @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model StockMovement {
  id Int @id @default(autoincrement())

  productId Int
  product   products @relation(fields: [productId], references: [id], onDelete: Cascade)

  type          String
  quantity      Int
  balanceBefore Int
  balanceAfter  Int

  referenceNo String?
  note        String?

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// ระบบสมาชิก (Member System)
// ------------------------------------------------------

model member {
  id             Int      @id @default(autoincrement())
  organizationId Int      // ผูกกับสาขาหรือร้านค้า
  phone          String   // เบอร์โทรศัพท์ (ใช้ค้นหา/ล็อกอิน)
  firstName      String   // ชื่อ
  lastName       String?  // นามสกุล

  // ยอดคงเหลือต่างๆ
  points         Int      @default(0)   // แต้มสะสม
  creditBalance  Float    @default(0.0) // เครดิตร้านค้า (เงินที่เติมไว้)

  // สถานะและระดับ
  tierId         Int?     // ระดับสมาชิก 
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE, BANNED

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ความสัมพันธ์
  organization   organizations       @relation(fields: [organizationId], references: [id])
  tier           membertier?         @relation(fields: [tierId], references: [id])
  transactions   membertransaction[] 
  orders         orders[]            // ผูกบิลเข้ากับสมาชิก (ถ้าต้องการ)

  @@unique([phone, organizationId])
}

model membertier {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  name            String   // ชื่อระดับ (เช่น "Gold Member")
  minSpending     Float    @default(0) // ยอดใช้จ่ายขั้นต่ำเพื่อเลื่อนระดับ
  pointMultiplier Float    @default(1.0) // ตัวคูณแต้ม 
  discountPercent Float    @default(0.0) // ส่วนลดพื้นฐานของระดับนี้ (%)

  organization    organizations @relation(fields: [organizationId], references: [id])
  members         member[]
}

model membertransaction {
  id             Int             @id @default(autoincrement())
  organizationId Int
  type           transactiontype 
  walletType     wallettype      
  amount         Float           // จำนวน (ติดลบ=ใช้ไป, บวก=ได้รับ)
  balanceAfter   Float           // ยอดคงเหลือหลังทำรายการ
  note           String?         
  createdAt      DateTime        @default(now())
  referenceTxId  Int?            // ระบุว่าจ่ายให้ transaction(SPEND) ID ไหน
  paymentGroupId String?         

  date           DateTime?
  memberId       Int
  member         member          @relation(fields: [memberId], references: [id])

  orderId        Int? 
  order          orders?         @relation(fields: [orderId], references: [id]) // อ้างอิง orders ระบบใหม่

  createdById    Int? 
  employee       employees?      @relation(fields: [createdById], references: [id]) // อ้างอิง employees ระบบใหม่
  
  organization   organizations   @relation(fields: [organizationId], references: [id])
}

enum transactiontype {
  EARN    // ได้รับ 
  REDEEM  // แลกใช้ 
  TOPUP   // เติมเงิน 
  SPEND   // จ่ายเงิน 
  REFUND  // คืนเงิน/คืนแต้ม
}

enum wallettype {
  POINT   // แต้มสะสม
  CREDIT  // เครดิตร้านค้า (เงินสด)
}