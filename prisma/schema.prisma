// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS (กำหนดตัวเลือกสถานะต่างๆ เพื่อป้องกันการพิมพ์ผิด)
enum OrderStatus {
  CART
  HOLD
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KitchenStatus {
  IDLE // ยังไม่ส่งเข้าครัว (อยู่ในตะกร้า)
  NOT_REQUIRED // ไม่ต้องส่งครัว (เช่น น้ำอัดลม หยิบเองหน้าบาร์ได้เลย)
  IN_KITCHEN // ไปโชว์ที่หน้าจอครัวแล้ว (รอครัวกดเสิร์ฟ)
  SERVED // ครัวกดปุ่ม "ส่งอาหารแล้ว" (จบ)
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

model organizations {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String?
  ownerId   Int
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  products products[]
  qrcodes  qrcodes[]
  orders   orders[]
  payments payments[]
}

model products {
  id             Int           @id @default(autoincrement())
  name           String
  price          Float
  image          String?
  stock          Int           @default(0)
  barcode        String?
  isActive       Boolean       @default(true)

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])
  orderItems     orderitems[]

  createdBy      String?       

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model qrcodes {
  id             Int           @id @default(autoincrement())
  token          String        @unique
  tableName      String
  isActive       Boolean       @default(true)

  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  orders         orders[]

  createdBy      String?       

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model orders {
  id              Int           @id @default(autoincrement())
  orderNumber     String        @unique 
  status          OrderStatus   @default(CART)
  orderType       OrderType     @default(DINE_IN)
  kitchenStatus   KitchenStatus @default(IDLE)

  totalAmount     Float         @default(0)
  discount        Float         @default(0)
  netAmount       Float         @default(0)

  qrCodeId        Int?
  qrcode          qrcodes?      @relation(fields: [qrCodeId], references: [id])

  customerName    String?
  customerPhone   String?
  deliveryAddress String?

  organizationId  Int
  organization    organizations @relation(fields: [organizationId], references: [id])
  items           orderitems[]
  payments        payments[]

  createdBy       String?       
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model orderitems {
  id             Int           @id @default(autoincrement())
  quantity       Int           @default(1)
  priceAtTime    Float
  options        String?
  status         KitchenStatus @default(IDLE)

  orderId        Int
  order          orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      Int
  product        products      @relation(fields: [productId], references: [id])

  createdBy      String?       

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model payments {
  id             Int           @id @default(autoincrement())
  amount         Float
  method         PaymentMethod @default(CASH)
  referenceNo    String?
  isCompleted    Boolean       @default(true)

  orderId        Int
  order          orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationId Int
  organization   organizations @relation(fields: [organizationId], references: [id])

  createdBy      String?      

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
